<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Identity values come from Partner Center: in Visual Studio use
       Project > Publish > Associate App with the Store to fill these in. -->
  <Identity Name="JELEnterprises.CosmoCab"
            Publisher="CN=CA45131B-EF29-4355-9B3F-3E2A266DFBB0"
            Version="1.0.14.0" />

  <mp:PhoneIdentity PhoneProductId="69b8303c-fcac-4858-8624-517b7f202bbd" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>CosmoCab</DisplayName>
    <PublisherDisplayName>JEL Enterprises</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="CosmoCab.App">
      <uap:VisualElements
        DisplayName="CosmoCab"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="An original arcade flier: pick up passengers, master gravity, and land gently."
        BackgroundColor="#05060e">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#05060e" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
